tStyle=1;align=center;verticalAlign=middle;strokeColor=none;fontSize=12;" value="1" vertex="1"><mxGeometry as="geometry" height="24" width="24" x="140" y="395" /></mxCell><mxCell id="s2" parent="1" style="shape=ellipse;fillColor=#000000;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fontSize=12;" value="2" vertex="1"><mxGeometry as="geometry" height="24" width="24" x="305" y="300" /></mxCell><mxCell id="s3" parent="1" style="shape=ellipse;fillColor=#000000;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fontSize=12;" value="3" vertex="1"><mxGeometry as="geometry" height="24" width="24" x="335" y="395" /></mxCell><mxCell id="s4" parent="1" style="shape=ellipse;fillColor=#000000;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fontSize=12;" value="4" vertex="1"><mxGeometry as="geometry" height="24" width="24" x="450" y="395" /></mxCell><mxCell id="s5" parent="1" style="shape=ellipse;fillColor=#000000;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fontSize=12;" value="5" vertex="1"><mxGeometry as="geometry" height="24" width="24" x="650" y="395" /></mxCell><mxCell id="s6" parent="1" style="shape=ellipse;fillColor=#000000;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fontSize=12;" value="6" vertex="1"><mxGeometry as="geometry" height="24" width="24" x="815" y="300" /></mxCell><mxCell id="s7" parent="1" style="shape=ellipse;fillColor=#000000;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fontSize=12;" value="7" vertex="1"><mxGeometry as="geometry" height="24" width="24" x="1125" y="285" /></mxCell><mxCell id="s8" parent="1" style="shape=ellipse;fillColor=#000000;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fontSize=12;" value="8" vertex="1"><mxGeometry as="geometry" height="24" width="24" x="1262" y="410" /></mxCell><mxCell id="s9" parent="1" style="shape=ellipse;fillColor=#000000;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fontSize=12;" value="9" vertex="1"><mxGeometry as="geometry" height="24" width="24" x="915" y="700" /></mxCell><mxCell id="s10" parent="1" style="shape=ellipse;fillColor=#000000;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fontSize=12;" value="10" vertex="1"><mxGeometry as="geometry" height="24" width="24" x="1118" y="700" /></mxCell><mxCell id="legend" parent="1" style="shape=rectangle;fillColor=#ffffff;strokeColor=#cccccc;fontColor=#000000;align=left;verticalAlign=top;fontSize=12;spacing=8;html=1;" value="&lt;b&gt;Architecture Workflow:&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Client requests app.&lt;br&gt;2. CloudFront serves static UI from S3.&lt;br&gt;3. API requests route to IGW.&lt;br&gt;4. IGW routes to ALB.&lt;br&gt;5. ALB path-based routing to Fargate.&lt;br&gt;6. Cloud Map DNS for service discovery.&lt;br&gt;7. Auth uses Redis for session cache.&lt;br&gt;8. Redis replication across AZs.&lt;br&gt;9. CodeDeploy blue/green container updates.&lt;br&gt;10. Runtime secret injection via Secrets Manager." vertex="1"><mxGeometry as="geometry" height="250" width="320" x="20" y="780" /></mxCell></root></mxGraphModel></diagram></mxfile>