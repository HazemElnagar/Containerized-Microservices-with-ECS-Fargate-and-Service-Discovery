as="geometry" height="24" width="24" x="238" y="220" /></mxCell><mxCell id="s2" parent="1" style="shape=ellipse;fillColor=#000000;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fontSize=12;" value="2" vertex="1"><mxGeometry as="geometry" height="24" width="24" x="238" y="380" /></mxCell><mxCell id="s3" parent="1" style="shape=ellipse;fillColor=#000000;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fontSize=12;" value="3" vertex="1"><mxGeometry as="geometry" height="24" width="24" x="238" y="540" /></mxCell><mxCell id="s4" parent="1" style="shape=ellipse;fillColor=#000000;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fontSize=12;" value="4" vertex="1"><mxGeometry as="geometry" height="24" width="24" x="138" y="540" /></mxCell><mxCell id="s5" parent="1" style="shape=ellipse;fillColor=#000000;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fontSize=12;" value="5" vertex="1"><mxGeometry as="geometry" height="24" width="24" x="500" y="778" /></mxCell><mxCell id="s6" parent="1" style="shape=ellipse;fillColor=#000000;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fontSize=12;" value="6" vertex="1"><mxGeometry as="geometry" height="24" width="24" x="780" y="778" /></mxCell><mxCell id="s7" parent="1" style="shape=ellipse;fillColor=#000000;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fontSize=12;" value="7" vertex="1"><mxGeometry as="geometry" height="24" width="24" x="738" y="338" /></mxCell><mxCell id="s8" parent="1" style="shape=ellipse;fillColor=#000000;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fontSize=12;" value="8" vertex="1"><mxGeometry as="geometry" height="24" width="24" x="738" y="638" /></mxCell><mxCell id="s9" parent="1" style="shape=ellipse;fillColor=#000000;fontColor=#ffffff;fontStyle=1;align=center;verticalAlign=middle;strokeColor=none;fontSize=12;" value="9" vertex="1"><mxGeometry as="geometry" height="24" width="24" x="788" y="540" /></mxCell><mxCell id="legend" parent="1" style="shape=rectangle;fillColor=#ffffff;strokeColor=#cccccc;fontColor=#000000;align=left;verticalAlign=top;fontSize=14;spacing=10;html=1;" value="&lt;b&gt;Blue/Green Deployment Flow:&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Developer pushes code to Source Repo.&lt;br&gt;2. CodePipeline triggers CodeBuild.&lt;br&gt;3. CodeBuild builds new Docker image and pushes to ECR.&lt;br&gt;4. CodePipeline triggers CodeDeploy.&lt;br&gt;5. CodeDeploy creates a replacement (Green) Task Set in ECS.&lt;br&gt;6. Green tasks pull the new image from ECR and start up.&lt;br&gt;7. ALB Prod Listener (443) continues sending 100% live traffic to Blue.&lt;br&gt;8. ALB Test Listener (8443) routes test traffic to Green.&lt;br&gt;9. After automated tests pass, CodeDeploy shifts traffic from Prod Listener to Green." vertex="1"><mxGeometry as="geometry" height="120" width="1500" x="50" y="950" /></mxCell></root></mxGraphModel></diagram></mxfile>